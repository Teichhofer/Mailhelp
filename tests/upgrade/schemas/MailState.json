            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration_is_upper_bound": {
          "default": false,
          "title": "Duration Is Upper Bound",
          "type": "boolean"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "end_origin": {
          "default": "unknown",
          "enum": [
            "unknown",
            "mail_end",
            "mail_duration",
            "calendar",
            "standard",
            "manual"
          ],
          "title": "End Origin",
          "type": "string"
        },
        "evidence": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "explicit_create_fallback_confirmed": {
          "default": false,
          "title": "Explicit Create Fallback Confirmed",
          "type": "boolean"
        },
        "explicit_duplicate_create_confirmed_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explicit Duplicate Create Confirmed Version"
        },
        "explicit_non_binding_create_confirmed": {
          "default": false,
          "title": "Explicit Non Binding Create Confirmed",
          "type": "boolean"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "external_link": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Link"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "is_cancellation": {
          "default": false,
          "title": "Is Cancellation",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ProposalKind"
        },
        "known_temporal_facts": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnownTemporalFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "matching_candidates": {
          "items": {
            "$ref": "#/$defs/ProposalReference"
          },
          "maxItems": 50,
          "title": "Matching Candidates",
          "type": "array"
        },
        "meeting_mode": {
          "default": "unknown",
