{
  "$defs": {
    "ActionRoute": {
      "additionalProperties": false,
      "description": "Bounded action classification before detailed extraction.\n\nFor ``unclear`` the counters are the number of possible task/event\ncandidates seen by the router.  One of them may be zero.  A counted\ncandidate is still extracted so that its uncertainty can be reviewed in a\nconcrete proposal instead of being hidden behind a generic message.  An\n``unclear`` route without any candidate has nothing to review and is\ntreated as ``none``; otherwise it only produced an unanswerable hint.",
      "properties": {
        "action_state": {
          "enum": [
            "none",
            "task",
            "event",
            "task_and_event",
            "unclear"
          ],
          "title": "Action State",
          "type": "string"
        },
        "event_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Event Count",
          "type": "integer"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "task_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Task Count",
          "type": "integer"
        }
      },
      "required": [
        "action_state",
        "task_count",
        "event_count",
        "reason"
      ],
      "title": "ActionRoute",
      "type": "object"
    },
    "DisplayHeaders": {
      "additionalProperties": false,
      "description": "Sanitized, bounded headers retained for user-facing notifications.",
      "properties": {
        "sender": {
          "maxLength": 500,
          "title": "Sender",
          "type": "string"
        },
        "subject": {
          "maxLength": 500,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "sender",
        "subject"
      ],
      "title": "DisplayHeaders",
      "type": "object"
    },
    "DuplicateDecision": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "new",
            "duplicate",
            "ambiguous"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "previous_mail_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{24}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Mail Id"
        },
        "reason": {
          "enum": [
            "no_match",
            "same_message",
            "missing_message_id",
            "multiple_message_ids",
            "message_id_reused",
            "fingerprint_collision",
            "candidate_incomplete"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "reason"
      ],
      "title": "DuplicateDecision",
      "type": "object"
    },
    "DuplicateMatchInfo": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "details": {
          "default": "",
          "maxLength": 1000,
          "title": "Details",
          "type": "string"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "external_link": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Link"
        },
        "matched_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Time"
        },
        "matched_title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Matched Title",
          "type": "string"
        },
        "similarity_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity Score"
        },
        "source": {
          "$ref": "#/$defs/DuplicateSource"
        }
      },
      "required": [
        "source",
        "matched_title"
      ],
      "title": "DuplicateMatchInfo",
      "type": "object"
    },
    "DuplicateSource": {
      "enum": [
        "action_ledger",
        "google_calendar",
        "todoist"
      ],
      "title": "DuplicateSource",
      "type": "string"
    },
    "EventExtraction": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/ExtractedEvent"
          },
          "maxItems": 20,
          "title": "Events",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "events"
      ],
      "title": "EventExtraction",
      "type": "object"
    },
    "ExtractedEvent": {
      "additionalProperties": false,
      "description": "Unnormalised event facts; missing facts remain explicitly absent.",
      "properties": {
        "certainty": {
          "enum": [
            "certain",
            "uncertain",
            "contradictory"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "classification": {
          "enum": [
            "new",
            "non_binding",
            "already_completed",
            "change",
            "cancellation",
            "recurring",
            "unsupported"
          ],
          "title": "Classification",
          "type": "string"
        },
        "date_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Text"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "duration_is_upper_bound": {
          "default": false,
          "title": "Duration Is Upper Bound",
          "type": "boolean"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "end_time_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time Text"
        },
        "evidence": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "responsibility": {
          "enum": [
            "user",
            "other",
            "unclear"
          ],
          "title": "Responsibility",
          "type": "string"
        },
        "time_requirement": {
          "$ref": "#/$defs/TimeRequirement"
        },
        "time_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Text"
        },
        "timezone_offset_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone Offset Text"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "video_link": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Link"
        }
      },
      "required": [
        "title",
        "evidence",
        "time_requirement",
        "responsibility",
        "certainty",
        "classification"
      ],
      "title": "ExtractedEvent",
      "type": "object"
    },
    "ExtractedTask": {
      "additionalProperties": false,
      "description": "Unnormalised task facts copied from an untrusted message.",
      "properties": {
        "certainty": {
          "enum": [
            "certain",
            "uncertain",
            "contradictory"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "classification": {
          "enum": [
            "new",
            "non_binding",
            "already_completed",
            "change",
            "cancellation",
            "recurring",
            "unsupported"
          ],
          "title": "Classification",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "due_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Text"
        },
        "evidence": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "responsibility": {
          "enum": [
            "user",
            "other",
            "unclear"
          ],
          "title": "Responsibility",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "evidence",
        "responsibility",
        "certainty",
        "classification"
      ],
      "title": "ExtractedTask",
      "type": "object"
    },
    "ExtractionCountConflict": {
      "additionalProperties": false,
      "description": "Durable evidence that a router count disagreed with an extraction.",
      "properties": {
        "actual_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Actual Count",
          "type": "integer"
        },
        "category": {
          "enum": [
            "task",
            "event"
          ],
          "title": "Category",
          "type": "string"
        },
        "expected_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Expected Count",
          "type": "integer"
        },
        "extractor_call_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Extractor Call Id",
          "type": "string"
        },
        "notification_marked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notification Marked At"
        },
        "router_call_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Router Call Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "category",
        "expected_count",
        "actual_count",
        "router_call_id",
        "extractor_call_id"
      ],
      "title": "ExtractionCountConflict",
      "type": "object"
    },
    "KnownTemporalFacts": {
      "additionalProperties": false,
      "description": "Valid temporal facts retained while an event interval is incomplete.",
      "properties": {
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "start_time": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time"
        }
      },
      "title": "KnownTemporalFacts",
      "type": "object"
    },
    "MailImapIdentity": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[a-f0-9]{24}$",
          "title": "Account Id",
          "type": "string"
        },
        "folder": {
          "minLength": 1,
          "title": "Folder",
          "type": "string"
        },
        "uid": {
          "minimum": 1,
          "title": "Uid",
          "type": "integer"
        },
        "uidvalidity": {
          "minimum": 1,
          "title": "Uidvalidity",
          "type": "integer"
        }
      },
      "required": [
        "account_id",
        "folder",
        "uidvalidity",
        "uid"
      ],
      "title": "MailImapIdentity",
      "type": "object"
    },
    "ProcessingError": {
      "additionalProperties": false,
      "description": "Persistierbarer Fehler ohne Inhalte oder technische Ausnahmeinformationen.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ProcessingErrorCode"
        },
        "notification_marked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notification Marked At"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "retryable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retryable"
        },
        "stage": {
          "$ref": "#/$defs/ProcessingStage"
        }
      },
      "required": [
        "code",
        "stage",
        "occurred_at"
      ],
      "title": "ProcessingError",
      "type": "object"
    },
    "ProcessingErrorCode": {
      "enum": [
        "mime_limit_exceeded",
        "llm_schema_validation_exhausted",
        "provider_response_invalid",
        "invalid_json",
        "schema_validation_failed",
        "permanent_adapter_error",
        "llm_rate_limited",
        "internal_error"
      ],
      "title": "ProcessingErrorCode",
      "type": "string"
    },
    "ProcessingStage": {
      "enum": [
        "preparation",
        "relevance",
        "summary",
        "summary_notification",
        "action_detection",
        "action_router",
        "task_extraction",
        "event_extraction",
        "normalization",
        "proposal_building",
        "duplicate_precheck",
        "proposal_notification",
        "completion"
      ],
      "title": "ProcessingStage",
      "type": "string"
    },
    "ProcessingSteps": {
      "additionalProperties": false,
      "properties": {
        "action_detection": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Action Detection",
          "type": "string"
        },
        "action_router": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Action Router",
          "type": "string"
        },
        "completion": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "skipped"
          ],
          "title": "Completion",
          "type": "string"
        },
        "duplicate_precheck": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Duplicate Precheck",
          "type": "string"
        },
        "event_extraction": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Event Extraction",
          "type": "string"
        },
        "normalization": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Normalization",
          "type": "string"
        },
        "preparation": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "skipped"
          ],
          "title": "Preparation",
          "type": "string"
        },
        "proposal_building": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Proposal Building",
          "type": "string"
        },
        "proposal_notification": {
          "default": "pending",
          "enum": [
            "pending",
            "sending",
            "completed",
            "skipped"
          ],
          "title": "Proposal Notification",
          "type": "string"
        },
        "relevance": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "skipped"
          ],
          "title": "Relevance",
          "type": "string"
        },
        "summary": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "skipped"
          ],
          "title": "Summary",
          "type": "string"
        },
        "summary_notification": {
          "default": "pending",
          "enum": [
            "pending",
            "sending",
            "completed",
            "skipped"
          ],
          "title": "Summary Notification",
          "type": "string"
        },
        "task_extraction": {
          "default": "pending",
          "enum": [
            "pending",
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Task Extraction",
          "type": "string"
        }
      },
      "title": "ProcessingSteps",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "all_day": {
          "default": false,
          "title": "All Day",
          "type": "boolean"
        },
        "canonical_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "certainty": {
          "$ref": "#/$defs/ProposalCertainty"
        },
        "classification": {
          "$ref": "#/$defs/ProposalClassification"
        },
        "default_duration_minutes": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Duration Minutes"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "due": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due"
        },
        "duplicate_check_failed": {
          "default": false,
          "title": "Duplicate Check Failed",
          "type": "boolean"
        },
        "duplicate_match": {
          "anyOf": [
            {
              "$ref": "#/$defs/DuplicateMatchInfo"
