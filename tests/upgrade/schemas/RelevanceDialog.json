{
  "$defs": {
    "RelevanceDialogStatus": {
      "enum": [
        "open",
        "decided"
      ],
      "title": "RelevanceDialogStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision": {
      "anyOf": [
        {
          "enum": [
            "relevant",
            "irrelevant"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision"
    },
    "mail_id": {
      "pattern": "^[a-f0-9]{24}$",
      "title": "Mail Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/RelevanceDialogStatus",
      "default": "open"
    },
    "telegram_offset": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Telegram Offset"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "mail_id"
  ],
  "title": "RelevanceDialog",
  "type": "object"
}
