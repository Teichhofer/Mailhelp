{
  "additionalProperties": false,
  "properties": {
    "mail_id": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{24}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mail Id"
    },
    "normalized_answer": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalized Answer"
    },
    "proposal_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Id"
    },
    "question": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question"
    },
    "retry_required": {
      "default": false,
      "title": "Retry Required",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    }
  },
  "title": "TelegramDialogState",
  "type": "object"
}
