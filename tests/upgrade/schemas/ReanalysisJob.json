          "default": null,
          "title": "Resolution"
        },
        "responsibility": {
          "$ref": "#/$defs/ProposalResponsibility"
        },
        "schema_version": {
          "const": 3,
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "separated_from": {
          "items": {
            "$ref": "#/$defs/ProposalReference"
          },
          "maxItems": 50,
          "title": "Separated From",
          "type": "array"
        },
        "series_key": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
