          "default": null,
          "title": "Mail Link"
        },
        "matching_candidates": {
          "items": {
            "$ref": "#/$defs/ProposalReference"
          },
          "maxItems": 50,
          "title": "Matching Candidates",
          "type": "array"
        },
        "meeting_mode": {
          "default": "unknown",
          "enum": [
            "video",
            "in_person",
            "hybrid",
            "unknown"
          ],
          "title": "Meeting Mode",
          "type": "string"
        },
        "merge_review_required": {
          "default": false,
          "title": "Merge Review Required",
          "type": "boolean"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        },
        "original_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Date"
        },
        "pending_sources": {
          "items": {
            "$ref": "#/$defs/ProposalReference"
          },
