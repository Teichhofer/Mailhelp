        "target_event_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Event Id"
        },
        "target_profile": {
          "default": 1,
          "maximum": 99,
          "minimum": 1,
          "title": "Target Profile",
          "type": "integer"
        },
        "target_provider": {
          "default": "",
          "maxLength": 30,
          "title": "Target Provider",
          "type": "string"
        },
        "temporal_fact": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalFact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "time_changes": {
          "items": {
            "type": "string"
          },
          "title": "Time Changes",
          "type": "array"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "uncertain_notified": {
          "default": false,
          "title": "Uncertain Notified",
          "type": "boolean"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "video_link": {
          "anyOf": [
            {
              "format": "uri",
