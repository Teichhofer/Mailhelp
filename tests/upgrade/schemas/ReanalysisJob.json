{
  "$defs": {
    "ActionRoute": {
      "additionalProperties": false,
      "description": "Bounded action classification before detailed extraction.\n\nFor ``unclear`` the counters are the number of possible task/event\ncandidates seen by the router.  One of them may be zero.  A counted\ncandidate is still extracted so that its uncertainty can be reviewed in a\nconcrete proposal instead of being hidden behind a generic message.  An\n``unclear`` route without any candidate has nothing to review and is\ntreated as ``none``; otherwise it only produced an unanswerable hint.",
      "properties": {
        "action_state": {
          "enum": [
            "none",
            "task",
            "event",
            "task_and_event",
            "unclear"
          ],
          "title": "Action State",
          "type": "string"
        },
        "event_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Event Count",
          "type": "integer"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "reply_needed": {
          "default": false,
          "title": "Reply Needed",
          "type": "boolean"
        },
        "reply_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply Reason"
        },
        "task_count": {
          "maximum": 20,
          "minimum": 0,
          "title": "Task Count",
          "type": "integer"
        }
      },
      "required": [
        "action_state",
        "task_count",
        "event_count",
        "reason"
      ],
      "title": "ActionRoute",
      "type": "object"
    },
    "CalendarCandidate": {
      "additionalProperties": false,
      "description": "An existing calendar entry a change or cancellation may refer to (4.6, 17.3).\n\nOnly entries found by the calendar search are stored; the user picks one of them.",
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ],
          "title": "End"
        },
        "event_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ],
          "title": "Start"
        },
        "title": {
          "default": "",
          "maxLength": 500,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "start",
        "end"
      ],
      "title": "CalendarCandidate",
      "type": "object"
    },
    "DuplicateMatchInfo": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "title": "Checked At",
          "type": "string"
        },
        "details": {
          "default": "",
          "maxLength": 1000,
          "title": "Details",
          "type": "string"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "external_link": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Link"
        },
        "matched_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Time"
        },
        "matched_title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Matched Title",
          "type": "string"
        },
        "similarity_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity Score"
        },
        "source": {
          "$ref": "#/$defs/DuplicateSource"
        }
      },
      "required": [
        "source",
        "matched_title"
      ],
      "title": "DuplicateMatchInfo",
      "type": "object"
    },
    "DuplicateSource": {
      "enum": [
        "action_ledger",
        "google_calendar",
        "todoist"
      ],
      "title": "DuplicateSource",
      "type": "string"
    },
    "EventExtraction": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/ExtractedEvent"
          },
          "maxItems": 20,
          "title": "Events",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "events"
      ],
      "title": "EventExtraction",
      "type": "object"
    },
    "ExtractedEvent": {
      "additionalProperties": false,
      "description": "Unnormalised event facts; missing facts remain explicitly absent.",
      "properties": {
        "certainty": {
          "enum": [
            "certain",
            "uncertain",
            "contradictory"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "classification": {
          "enum": [
            "new",
            "non_binding",
            "already_completed",
            "change",
            "cancellation",
            "recurring",
            "unsupported"
          ],
          "title": "Classification",
          "type": "string"
        },
        "date_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Text"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "duration_is_upper_bound": {
          "default": false,
          "title": "Duration Is Upper Bound",
          "type": "boolean"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "end_time_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time Text"
        },
        "evidence": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "original_date_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Date Text"
        },
        "responsibility": {
          "enum": [
            "user",
            "other",
            "unclear"
          ],
          "title": "Responsibility",
          "type": "string"
        },
        "time_requirement": {
          "$ref": "#/$defs/TimeRequirement"
        },
        "time_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Text"
        },
        "timezone_offset_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone Offset Text"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "video_link": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Link"
        }
      },
      "required": [
        "title",
        "evidence",
        "time_requirement",
        "responsibility",
        "certainty",
        "classification"
      ],
      "title": "ExtractedEvent",
      "type": "object"
    },
    "ExtractedTask": {
      "additionalProperties": false,
      "description": "Unnormalised task facts copied from an untrusted message.",
      "properties": {
        "certainty": {
          "enum": [
            "certain",
            "uncertain",
            "contradictory"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "classification": {
          "enum": [
            "new",
            "non_binding",
            "already_completed",
            "change",
            "cancellation",
            "recurring",
            "unsupported"
          ],
          "title": "Classification",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "due_text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Text"
        },
        "evidence": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "responsibility": {
          "enum": [
            "user",
            "other",
            "unclear"
          ],
          "title": "Responsibility",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "evidence",
        "responsibility",
        "certainty",
        "classification"
      ],
      "title": "ExtractedTask",
      "type": "object"
    },
    "KnownTemporalFacts": {
      "additionalProperties": false,
      "description": "Valid temporal facts retained while an event interval is incomplete.",
      "properties": {
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "start_time": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time"
        }
      },
      "title": "KnownTemporalFacts",
      "type": "object"
    },
    "MailImapIdentity": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "pattern": "^[a-f0-9]{24}$",
          "title": "Account Id",
          "type": "string"
        },
        "folder": {
          "minLength": 1,
          "title": "Folder",
          "type": "string"
        },
        "uid": {
          "minimum": 1,
          "title": "Uid",
          "type": "integer"
        },
        "uidvalidity": {
          "minimum": 1,
          "title": "Uidvalidity",
          "type": "integer"
        }
      },
      "required": [
        "account_id",
        "folder",
        "uidvalidity",
        "uid"
      ],
      "title": "MailImapIdentity",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "all_day": {
          "default": false,
          "title": "All Day",
          "type": "boolean"
        },
        "base_title": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Title"
        },
        "calendar_candidates": {
          "items": {
            "$ref": "#/$defs/CalendarCandidate"
          },
          "maxItems": 10,
          "title": "Calendar Candidates",
          "type": "array"
        },
        "canonical_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposalReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "certainty": {
          "$ref": "#/$defs/ProposalCertainty"
        },
        "classification": {
          "$ref": "#/$defs/ProposalClassification"
        },
        "confirmed_web_actor": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^web:.+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed Web Actor"
        },
        "default_duration_minutes": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Duration Minutes"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "due": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due"
        },
        "duplicate_check_failed": {
          "default": false,
          "title": "Duplicate Check Failed",
          "type": "boolean"
        },
        "duplicate_match": {
          "anyOf": [
            {
              "$ref": "#/$defs/DuplicateMatchInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration_is_upper_bound": {
          "default": false,
          "title": "Duration Is Upper Bound",
          "type": "boolean"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "end_origin": {
          "default": "unknown",
          "enum": [
            "unknown",
            "mail_end",
            "mail_duration",
            "calendar",
            "standard",
            "manual"
          ],
          "title": "End Origin",
          "type": "string"
        },
        "evidence": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "explicit_create_fallback_confirmed": {
          "default": false,
          "title": "Explicit Create Fallback Confirmed",
          "type": "boolean"
        },
        "explicit_duplicate_create_confirmed_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explicit Duplicate Create Confirmed Version"
        },
        "explicit_non_binding_create_confirmed": {
          "default": false,
          "title": "Explicit Non Binding Create Confirmed",
          "type": "boolean"
        },
        "external_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Id"
        },
        "external_link": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Link"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "is_cancellation": {
          "default": false,
          "title": "Is Cancellation",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ProposalKind"
        },
        "known_temporal_facts": {
          "anyOf": [
            {
              "$ref": "#/$defs/KnownTemporalFacts"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "mail_link": {
          "anyOf": [
            {
              "maxLength": 2000,
              "pattern": "^(?:message://%3C[!#-&(-;=?-~]+%3E|https://mail\\.google\\.com/mail/u/0/#search/rfc822msgid%3A[!#-&(-;=?-~]+|https://outlook\\.office\\.com/mail/search\\?q=[!#-&(-;=?-~]+)$",
              "type": "string"
            },
            {
              "type": "null"
            }
