{
  "$defs": {
    "ReportEvent": {
      "additionalProperties": false,
      "description": "One dated activity; user corrections are kept apart from the model's values.",
      "properties": {
        "cancelled": {
          "default": false,
          "title": "Cancelled",
          "type": "boolean"
        },
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "edited": {
          "default": false,
          "title": "Edited",
          "type": "boolean"
        },
        "end_time": {
          "anyOf": [
            {
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time"
        },
        "evidence": {
          "default": "",
          "maxLength": 500,
          "title": "Evidence",
          "type": "string"
        },
        "excluded": {
          "default": false,
          "title": "Excluded",
          "type": "boolean"
        },
        "id": {
          "pattern": "^e[0-9]{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 300,
              "pattern": "^[^\\x00-\\x08\\x0b-\\x1f\\x7f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "manual": {
          "default": false,
          "title": "Manual",
          "type": "boolean"
        },
        "out_of_range": {
          "default": false,
          "title": "Out Of Range",
          "type": "boolean"
        },
        "start_time": {
          "anyOf": [
            {
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x08\\x0b-\\x1f\\x7f]*$",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "day"
      ],
      "title": "ReportEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accounted": {
      "default": false,
      "title": "Accounted",
      "type": "boolean"
    },
    "attachments": {
      "items": {
        "type": "string"
      },
      "title": "Attachments",
      "type": "array"
    },
    "cached_input": {
      "default": false,
      "title": "Cached Input",
      "type": "boolean"
    },
    "confidence": {
      "anyOf": [
        {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ReportEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "events_call_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Events Call Id"
    },
    "events_extracted": {
      "default": false,
      "title": "Events Extracted",
      "type": "boolean"
    },
    "failed_step": {
      "anyOf": [
        {
          "enum": [
            "relevance",
            "events"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failed Step"
    },
    "folder": {
      "title": "Folder",
      "type": "string"
    },
    "key": {
      "maxLength": 600,
      "minLength": 1,
      "title": "Key",
      "type": "string"
    },
    "message_id": {
      "default": "",
      "title": "Message Id",
      "type": "string"
    },
    "reason": {
      "default": "",
      "maxLength": 500,
      "title": "Reason",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "relevance_call_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relevance Call Id"
    },
    "relevant": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relevant"
    },
    "sender": {
      "default": "",
      "maxLength": 500,
      "title": "Sender",
      "type": "string"
    },
    "skipped": {
      "anyOf": [
        {
          "enum": [
            "sender",
            "automated",
            "size",
            "suspicious",
            "duplicate",
            "unreadable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Skipped"
    },
    "subject": {
      "default": "",
      "maxLength": 500,
      "title": "Subject",
      "type": "string"
    },
    "text": {
      "default": "",
      "title": "Text",
      "type": "string"
    },
    "text_removed": {
      "default": false,
      "title": "Text Removed",
      "type": "boolean"
    },
    "uid": {
      "title": "Uid",
      "type": "integer"
    },
    "user_relevant": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Relevant"
    }
  },
  "required": [
    "key",
    "folder",
    "uid",
    "received_at"
  ],
  "title": "ReportMail",
  "type": "object"
}
