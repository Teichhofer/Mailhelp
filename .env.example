# Postfach 1. Ab 3.1 auch IMAP_1_USERNAME/IMAP_1_PASSWORD; die nummerierten Namen haben Vorrang.
# Weitere Postfächer (imap.mailboxes in config.yaml) verwenden IMAP_<id>_USERNAME/IMAP_<id>_PASSWORD.
IMAP_USERNAME=
IMAP_PASSWORD=
# IServ-Elternbriefe (iserv.accounts in config.yaml): Elternkonto je Konto-ID.
# ISERV_1_USERNAME=
# ISERV_1_PASSWORD=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TODOIST_TOKEN=
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
# Google und Todoist werden nur verlangt, wenn sie in config.yaml (targets) gewählt sind.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# 3.2: Browseranmeldung auf dem Host: mailhelp --google-auth --profile 2
# OAuth-Client-ID/-Secret dürfen global geerbt werden; Tokens bleiben getrennt.
# Zusätzliche Zielprofile: nur Geheimnisse aktiv verwendeter Provider erforderlich.
# GOOGLE_OAUTH_2_CLIENT_ID=
# GOOGLE_OAUTH_2_CLIENT_SECRET=
# GOOGLE_OAUTH_2_REFRESH_TOKEN=
# TODOIST_2_TOKEN=
# TODOIST_2_CLIENT_ID=
# TODOIST_2_CLIENT_SECRET=
# MICROSOFT_2_CLIENT_ID=
# MICROSOFT_2_CLIENT_SECRET=
# MICROSOFT_2_REFRESH_TOKEN=
# CALDAV_2_USERNAME=
# CALDAV_2_PASSWORD=
# CalDAV (Nextcloud, iCloud, mailbox.org …) und Apple Erinnerungen: Benutzername und App-Passwort.
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Outlook-Kalender und Microsoft To Do: App-Registrierung mit "Öffentliche Clientflows zulassen";
# MICROSOFT_CLIENT_SECRET nur für vertrauliche Clients. Anmeldung: mailhelp --microsoft-login
# (speichert den Refresh-Token in microsoft-token.json neben dieser Datei).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REFRESH_TOKEN=
# Ausschließlich Geheimnisse gehören hierher; Einstellungen stehen in config.yaml.
# Nur mit web.enabled: true – Signaturschlüssel für Websitzungen und CSRF,
# mindestens 32 zufällige Zeichen, z. B. python -c "import secrets; print(secrets.token_urlsafe(48))"
MAILHELP_WEB_SECRET=
